# Copy this file to .env and fill in your values

# Used to sign JWT auth tokens - change this to a long random string
SECRET_KEY=change-this-to-a-long-random-secret-string

# Get a free key at https://aistudio.google.com/apikey (used for chart screenshot analysis via Gemini)
GEMINI_API_KEY=AQ.Ab8RN6K6rVr3ibePS_d-0Iq9SVR25vRvYnISoEFnRxejPsB39Q

# Optional - only needed if you want CryptoCompare/CoinDesk news instead of
# the built-in free RSS feeds (Cointelegraph, Decrypt, BeInCrypto), which
# work automatically with no key at all. Get a free key at
# https://developers.coindesk.com/ if you want this instead.
CRYPTOCOMPARE_API_KEY=

# Any password/secret you choose - required to post/edit/delete the "Trade of the Day"
# from the admin panel at /admin. Treat this like a password.
ADMIN_API_KEY=change-this-admin-key

# SQLite by default. Swap for Postgres in production, e.g:
# DATABASE_URL=postgresql://user:password@localhost:5432/crypto_app
DATABASE_URL=sqlite:///./crypto_app.db

# CORS - comma separated list of allowed origins, use * for dev
ALLOWED_ORIGINS=*
